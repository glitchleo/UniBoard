# Copy values into your environment; start with NODE_ENV=development explicitly.
NODE_ENV=development
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgresql://uniboard:uniboard@localhost:5432/uniboard
# Production requires HTTPS APP_ORIGIN and an email delivery integration.
# EMAIL_WEBHOOK_URL=https://your-mail-service.example/send
# EMAIL_WEBHOOK_TOKEN=replace-with-a-long-secret
# Only set TRUST_PROXY=1 behind a trusted single reverse proxy.
TRUST_PROXY=0
# SERVE_FRONTEND=1 serves ../campus/dist after building the frontend.
SERVE_FRONTEND=0
